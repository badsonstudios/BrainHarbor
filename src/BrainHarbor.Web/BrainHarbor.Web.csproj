<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Helpers like slug generation are internal but need direct unit tests. -->
    <InternalsVisibleTo Include="BrainHarbor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Database\Scripts\*.sql" />
    <!-- Curated Markdown pages (WI-104) + glossary terms (WI-105) must
         survive dotnet publish. -->
    <Content Include="Content\pages\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Content\glossary\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Content\taxonomy.yml" CopyToOutputDirectory="PreserveNewest" />
    <!-- ZIP -> coordinates for the trial finder's "near me" (WI-403). Census
         public-domain data; shipped as a file rather than a table because it is
         read-only reference data that changes once a year. -->
    <Content Include="Content\zcta-centroids.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>80f6863e-bdf6-4dda-8a8f-b38367f452c7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="Htmx" Version="1.12.0" />
    <PackageReference Include="Htmx.TagHelpers" Version="1.12.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
