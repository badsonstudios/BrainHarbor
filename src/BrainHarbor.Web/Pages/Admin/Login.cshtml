@page "/admin/login"
@model BrainHarbor.Web.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "Admin sign in";
}

@* WI-207. Deliberately plain: no "create an account", no password reset by
   email, no social login. One account, seeded from configuration. *@

<div class="container--read">
    <h1>Admin sign in</h1>

    @if (Model.ErrorMessage is not null)
    {
        <div class="disclaimer" role="alert">
            <p>@Model.ErrorMessage</p>
        </div>
    }

    <form method="post">
        <div>
            <label asp-for="Input.Email">Email</label><br />
            <input asp-for="Input.Email" type="email" autocomplete="username" required />
        </div>
        <div>
            <label asp-for="Input.Password">Password</label><br />
            <input asp-for="Input.Password" type="password" autocomplete="current-password" required />
        </div>
        <p><input type="submit" value="Sign in" /></p>
    </form>
</div>
