@page "/admin/two-factor-login"
@model BrainHarbor.Web.Pages.Admin.TwoFactorLoginModel
@{
    ViewData["Title"] = "Two-factor code";
}

<div class="container--read">
    <h1>Enter your code</h1>
    <p>Open your authenticator app and enter the 6-digit code.</p>

    @if (Model.ErrorMessage is not null)
    {
        <div class="disclaimer" role="alert"><p>@Model.ErrorMessage</p></div>
    }

    <form method="post">
        <div>
            <label asp-for="Code">Code</label><br />
            <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code"
                   pattern="[0-9]*" required />
        </div>
        <p><input type="submit" value="Verify" /></p>
    </form>
</div>
