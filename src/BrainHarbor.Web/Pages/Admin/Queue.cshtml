@page "/admin/queue"
@model BrainHarbor.Web.Pages.Admin.QueueModel
@{
    ViewData["Title"] = "Review queue";
}

@* WI-208: the human gate. Nothing on this site reaches a reader until
   someone approves it here. htmx swaps a row out on decision; without
   JavaScript the same forms post normally and the page re-renders. *@

<h1>Review queue</h1>

@if (!Model.TwoFactorEnabled)
{
    <div class="disclaimer" role="alert">
        <p>
            <strong>Two-factor is not on for your account.</strong> Approving
            an item publishes medical content to patients.
            <a href="/admin/two-factor">Turn on two-factor</a>.
        </p>
    </div>
}

@if (Model.Reported.Count > 0)
{
    <section class="reported-section" aria-labelledby="reported-heading">
        <h2 id="reported-heading">Reported by readers (@Model.ReportedCount)</h2>
        <p class="text-muted">
            These pages are live. A reader flagged a problem. Pull the page or,
            if it's fine, dismiss the flag.
        </p>
        <ul class="feed-grid">
            @foreach (var item in Model.Reported)
            {
                <li class="card" id="reported-item-@item.Id">
                    <div class="review-card__badges">
                        <partial name="_StageBadge" model="item.Badge" />
                        @if (item.Readiness is not null)
                        {
                            <partial name="_ReadinessBadge" model="item.Readiness" />
                        }
                    </div>
                    <h3><a href="/research/@item.Slug">@(item.PlainTitle ?? item.Title)</a></h3>
                    <form method="post" asp-page-handler="ResolveReport">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" name="action" value="pull">Pull from site</button>
                        <button type="submit" name="action" value="dismiss">Dismiss (keep published)</button>
                    </form>
                </li>
            }
        </ul>
    </section>
}

<p>
    <strong>@Model.PendingCount</strong> item(s) waiting.
    @if (Model.PendingCount > 0)
    {
        <text>Flagged items are listed first.</text>
    }
</p>

@if (Model.PendingCount > 0)
{
    <p class="text-muted" id="kbd-help">
        Keyboard: <kbd>j</kbd>/<kbd>k</kbd> move between items,
        <kbd>a</kbd> approve, <kbd>r</kbd> reject, <kbd>e</kbd> edit the focused item.
    </p>
}

@if (Model.Items.Count == 0)
{
    <p>Nothing to review. The pipeline uploads new items as it finds them.</p>
}

<ul class="feed-grid" id="review-queue">
    @foreach (var item in Model.Items)
    {
        <partial name="_ReviewRow" model="item" />
    }
</ul>

@if (Model.HasMore)
{
    <p>
        <a href="/admin/queue?page=@(Model.Page + 1)">Next page →</a>
    </p>
}

@section Scripts {
    <script>
        // Progressive enhancement (WI-305): keyboard-drive the queue. Everything
        // still works with the plain forms if this never runs.
        (function () {
            var cards = function () { return Array.prototype.slice.call(
                document.querySelectorAll('[data-review-card]')); };
            var focused = -1;

            function focus(i) {
                var list = cards();
                if (!list.length) return;
                focused = Math.max(0, Math.min(i, list.length - 1));
                list[focused].focus();
                list[focused].scrollIntoView({ block: 'nearest' });
            }

            function typingInField(e) {
                var t = e.target;
                return t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
            }

            document.addEventListener('keydown', function (e) {
                if (e.ctrlKey || e.metaKey || e.altKey) return;
                if (typingInField(e)) return;
                var card = focused >= 0 ? cards()[focused] : null;
                switch (e.key) {
                    case 'j': focus(focused + 1); e.preventDefault(); break;
                    case 'k': focus(focused - 1); e.preventDefault(); break;
                    case 'a':
                        if (card) { var a = card.querySelector('[data-approve]'); if (a) { a.click(); e.preventDefault(); } }
                        break;
                    case 'r':
                        if (card) { var r = card.querySelector('[data-reject]'); if (r) { r.click(); e.preventDefault(); } }
                        break;
                    case 'e':
                        if (card) {
                            var d = card.querySelector('.review-edit');
                            if (d) { d.open = true; var f = d.querySelector('input,textarea'); if (f) f.focus(); e.preventDefault(); }
                        }
                        break;
                }
            });
        })();
    </script>
}
