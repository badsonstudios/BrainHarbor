@page "/dev/styleguide"
@using BrainHarbor.Web.Models
@model BrainHarbor.Web.Pages.Dev.StyleGuideModel
@{
    ViewData["Title"] = "Style guide (dev only)";
}

@* WI-109 preview surface: every indicator kind + sample cards, for visual and
   a11y checks before real data exists. Development environment only —
   the page model 404s everywhere else. *@

<h1>Style guide</h1>
<p>Development only. Every evidence indicator, plus the feed card in the handoff grid.</p>

@* Every stage rendered at once is the fastest way to catch the two things
   that break quietly here: a connector that steps because the dot centres
   stopped matching, and a label that wraps differently at one stage only. *@
<h2>Journey path (reader-facing)</h2>
<ul class="styleguide-badges">
    @foreach (var stage in Enum.GetValues<ResearchStage>())
    {
        <li>
            <partial name="_JourneyPath" model="stage" />
            <code>@stage</code>
        </li>
    }
</ul>

<h2>Journey path, large (item page)</h2>
<partial name="_JourneyPath" model="ResearchStage.ReviewOfExistingResearch"
         view-data='new ViewDataDictionary(ViewData) { ["Modifier"] = "journey--lg" }' />

@* Retired from reader pages by the journey handoff, kept for the admin review
   queue — which still renders it, so it still needs checking. *@
<h2>Stage badges (admin queue only)</h2>
<ul class="styleguide-badges">
    @foreach (var stage in Enum.GetValues<ResearchStage>())
    {
        <li>
            <partial name="_StageBadge" model="StageBadge.For(stage)" />
            <code>@stage</code>
        </li>
    }
</ul>

<h2>Glossary tooltip</h2>
<p>
    The sentence below is run through the real ContentStore pipeline, so the
    first mention of each glossary term becomes a tooltip. Click or tab to
    one: the panel must be readable, dismissible with Esc, and the trigger
    must show a focus ring.
</p>
<div class="container--read">
    @Html.Raw(Model.TooltipSampleHtml)
</div>

<h2>Feed cards</h2>
<div class="section-head">
    <h3>Latest updates</h3>
    <a href="/research">See all →</a>
</div>
<p class="text-muted">
    The filled marks show how far along the evidence is. More marks mean it
    has been tested more.
</p>
<ul class="feed-grid">
    @foreach (var card in Model.SampleCards)
    {
        <partial name="_FeedCard" model="card" />
    }
</ul>
