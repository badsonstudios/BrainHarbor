@page "/glossary"
@using BrainHarbor.Web.Content
@model GlossaryModel
@{
    ViewData["Title"] = "Glossary";
}

@* WI-105: the A–Z glossary. Each term anchors at #slug — inline tooltips
   link here as the always-works fallback. *@

<div class="container--read">
    <h1>Glossary</h1>
    <p>
        Plain words for the medical terms you will hear. Any word with a
        dotted line under it opens its meaning here.
    </p>

    @if (Model.Terms.Count == 0)
    {
        <p>We are still writing the glossary. Check back soon.</p>
    }

    @foreach (var group in Model.Terms.GroupBy(t => char.ToUpperInvariant(t.Term[0])))
    {
        <h2>@group.Key</h2>
        @foreach (var term in group)
        {
            <h3 id="@term.Slug">
                @term.Term
                @if (!string.IsNullOrWhiteSpace(term.Pronunciation))
                {
                    <small class="text-muted">(@term.Pronunciation)</small>
                }
            </h3>
            <p>@term.Definition</p>
            @if (term.Aliases.Count > 0)
            {
                <p class="text-muted">Also called: @string.Join(", ", term.Aliases).</p>
            }
            @* WI-505: a definition is a medical claim, so it points at where it
               came from — the same rule, and the same markup, as the curated
               pages (see ContentPage.cshtml). A <ul> announces the item count
               to a screen reader; the inline comma-separated version did not. *@
            @if (term.Sources.Count > 0)
            {
                <p class="text-muted">Where this came from:</p>
                <ul class="term-sources">
                    @foreach (var source in term.Sources)
                    {
                        @* Never render a link with no text: an empty title is
                           a focusable control with no accessible name, which
                           fails WCAG 2.4.4 on a site where AA is a hard
                           requirement. Fall back to the host. *@
                        <li><a href="@source.Url">@GlossaryModel.LinkText(source)</a></li>
                    }
                </ul>
            }
        }
    }
</div>
