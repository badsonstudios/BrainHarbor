@page "/research"
@model BrainHarbor.Web.Pages.Research.IndexModel
@{
    ViewData["Title"] = "Research updates";
}

@* WI-209: the public feed. Filters are plain links (htmx swaps the results,
   but every control works without JavaScript). Early-stage work is hidden by
   default — a mouse-study headline reads as false hope (PLAN.md §3). *@

<h1>Research updates</h1>
<p>
    New brain tumor research and news, in plain language. The marks on each
    item show how far along the evidence is. More marks mean it has been
    tested more.
</p>

@* WI-457, Dan's ask. This page and /trials answer two different questions —
   "what has been found" and "what could I join" — and a reader who lands here
   looking for the second has no way to know the first page is not it. The nav
   has a Trials link, but a nav link is a thing you scan past; this is the
   question stated in the words someone would use to ask it.

   Sits above the filters rather than below the feed: someone whose real
   question is "can I get into a trial" should not have to read 20 research
   cards to discover they are on the wrong page. *@
<div class="cross-link">
    <p>
        <strong>Looking for a trial you could join?</strong>
        Research is what has been found. Trials are studies you can take part
        in now.
    </p>
    <p><a class="button" href="/trials">Find a clinical trial</a></p>
</div>

@* Stacked label-above-control, matching /trials (WI-460, Dan). Each pair is
   its own block so a wrap can never separate a label from the thing it
   labels. *@
<form method="get" class="feed-filters feed-filters--stacked"
      hx-get="/research" hx-target="#feed-results"
      hx-select="#feed-results" hx-swap="outerHTML show:none" hx-push-url="true">
    @* Marks a real form submit, so an unchecked "early" box is read as "off"
       and remembered — distinct from a plain visit that uses the saved choice. *@
    <input type="hidden" name="applied" value="true" />

    <div class="filter-field">
        <label for="tumor">Tumor type</label>
        <select id="tumor" name="tumor">
            <option value="">All types</option>
            @foreach (var type in Model.TumorTypes)
            {
                <option value="@type.Slug" selected="@(Model.Query.TumorType == type.Slug)">@type.Label</option>
            }
        </select>
    </div>

    @* Trials are gone from this list (WI-460, Dan): they live on /trials,
       which filters by country, recruiting status and phase — things this feed
       has no use for. Leaving the option here would offer a filter whose
       results are deliberately empty. *@
    <div class="filter-field">
        <label for="kind">Research kind</label>
        <select id="kind" name="kind">
            <option value="">Everything</option>
            <option value="research" selected="@(Model.Query.Kind == "research")">Research</option>
            <option value="news" selected="@(Model.Query.Kind == "news")">News</option>
            <option value="preprint" selected="@(Model.Query.Kind == "preprint")">Preprints</option>
        </select>
    </div>

    @* Impersonal on purpose: "helping you" would promise this reader an
       outcome (anti-hype rules). Group order mirrors FeedRepository.OrderByFor. *@
    <div class="filter-field">
        <label for="sort">Sort by</label>
        <select id="sort" name="sort">
            <option value="">Newest first</option>
            @* "Most ready to use" described the 1-to-10 readiness score, which the
               journey handoff retired. This now sorts by the four-stage ladder the
               cards actually show, so the words match what the reader sees. The
               value stays "readiness" so shared links keep working. *@
            <option value="readiness" selected="@(Model.Query.Sort == "readiness")">Furthest along</option>
            <option value="type" selected="@(Model.Query.Sort == "type")">By kind</option>
        </select>
    </div>

    @* Above the button, with the filters it belongs to — it changes which
       items appear, so it is a filter, not an afterthought. *@
    <label class="checkbox">
        <input type="checkbox" name="early" value="true" checked="@Model.Query.IncludeEarlyStage" />
        Show early-stage research (animal and lab studies)
    </label>

    <button class="feed-filters__submit" type="submit">Apply</button>
</form>

@* WI-412: when a reader has filtered to a type, offer the plain-English
   explanation of it right there. Someone who picked "oligodendroglioma" from a
   list because it is the word on their report is exactly the person who needs
   to know what it means, and asking them to go hunting for it is how you lose
   them. Outside #feed-results so an htmx swap of the results does not drop it. *@
@if (Model.Query.TumorType is { Length: > 0 } filtered)
{
    @* The label comes from the taxonomy, not from the slug: "dipg" is not a
       word, and "brain-metastases" de-hyphenated is still not how the list
       spells it. An unknown slug gets no link at all rather than a link that
       reads "What is ?". *@
    var label = Model.TumorTypes.FirstOrDefault(t => t.Slug == filtered)?.Label;
    if (label is not null)
    {
        <p><a href="/tumors#@filtered">What is @label?</a></p>
    }
}

<div id="feed-results">
    <p class="text-muted">
        @Model.Result.TotalCount item(s)@(Model.Query.IncludeEarlyStage
            ? ", including early-stage research"
            : ". Early-stage animal and lab research is hidden. Tick the box above to include it").
    </p>

    @if (Model.Result.Items.Count == 0)
    {
        <p>
            Nothing matches yet. Try clearing the filters, or
            <a href="/research">see everything</a>.
        </p>
    }

    <ul class="feed-grid">
        @foreach (var row in Model.Result.Items)
        {
            <partial name="_FeedCard" model="Model.ToCard(row)" />
        }
    </ul>

    @* Inside #feed-results so an htmx swap replaces the pager along with the
       cards — otherwise page 3's results would sit under page 2's pager. *@
    <partial name="_Pagination" model="Model.Pages"
             view-data='new ViewDataDictionary(ViewData) { ["PageUrl"] = (Func<int, string>)Model.UrlForPage, ["HxTarget"] = "#feed-results" }' />
</div>
