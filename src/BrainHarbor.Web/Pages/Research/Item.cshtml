@page "/research/{slug}"
@model BrainHarbor.Web.Pages.Research.ItemModel
@{
    ViewData["Title"] = Model.Item.PlainTitle ?? Model.Item.Title;
    ViewData["Description"] = Model.MetaDescription;
    ViewData["OgType"] = "article";
}

@section Head {
    @* One Html.Raw so Razor doesn't entity-encode the "+" in the type; the JSON
       is serialized with the default encoder (escapes < > &), so it can't break
       out of the <script>. *@
    @Html.Raw($"<script type=\"application/ld+json\">{Model.JsonLd()}</script>")
}

@* WI-306: the item permalink — the shareable, indexable unit of the site. The
   full six-block plain-language template, badged, with readiness, provenance,
   glossary tooltips, and a one-tap "report a problem". Layout follows the
   handoff's research-item.html: 46rem reading column, means-block, ai-note. *@

<div class="container--read">
    <p><a href="/research">← All research updates</a></p>

    @if (Model.JustReported)
    {
        <div class="disclaimer" role="status">
            <p>Thank you. You have flagged this summary for another look.</p>
        </div>
    }

    <div class="item-header">
        <h1>@(Model.Item.PlainTitle ?? Model.Item.Title)</h1>
        @if (Model.Item.PlainTitle is not null)
        {
            <p class="original-title">Original title: @Model.Item.Title</p>
        }
    </div>

    @* "How far along is this research?" sits HERE, right under the title, per
       the journey handoff — before the summary, so nobody reads a result
       without first seeing what kind of evidence produced it.

       This replaces three things that used to be spread down the page: a badge
       up here with no explanation, a 1-to-10 readiness callout in the middle,
       and a repeat of the badge near the foot. The repeat existed only because
       the top badge was unexplained and asking a reader to scroll back up to
       count dots is asking them to give up — with the path and its explanation
       together in one place, the reason for the repeat is gone.

       Both paragraphs earn their place: StageExplanation is the same for every
       item at this stage ("this was done in animals"), while ReadinessReason is
       written for THIS item ("only done in mice, and the drug did not work"). *@
    <h2>How far along is this research?</h2>
    <partial name="_JourneyPath" model="Model.Badge.Stage" view-data='new ViewDataDictionary(ViewData) { ["Modifier"] = "journey--lg" }' />
    <p>@Model.StageExplanation</p>
    @if (Model.Item.ReadinessReason is not null)
    {
        <p>@Model.Block(Model.Item.ReadinessReason)</p>
    }

    @* The trial's status as it is RIGHT NOW, read from the trial cache rather
       than from the summary (WI-402). The summary is written once and frozen;
       trials close. A page that still says "enrolling" about a closed trial
       sends someone to a door that no longer opens. *@
    @if (Model.Item.IsTrial && Model.Item.TrialStatus is not null)
    {
        <div class="trial-status @(Model.Item.TrialHasClosed ? "trial-status--closed" : "")" role="status">
            <p>
                <strong>
                    @(Model.Item.TrialHasClosed
                        ? "This trial is not taking new patients."
                        : $"Status: {Model.Item.TrialStatus}.")
                </strong>
                @Model.TrialStatusExplanation
            </p>
            @if (Model.Item.TrialUpdatedAt is { } updated)
            {
                <p class="trial-status__checked">
                    The trial team last updated this record on
                    <time datetime="@updated.ToString("yyyy-MM-dd")">@updated.ToString("MMMM d, yyyy")</time>.
                    Always check the trial page for the latest.
                </p>
            }
        </div>
    }

    @if (Model.Item.HasFullSummary)
    {
        <h2>The short version</h2>
        @if (Model.Item.PlainSummary is not null)
        {
            <p class="hook">@Model.Block(Model.Item.PlainSummary)</p>
        }
        @* A trial that is open has not found anything yet, so it gets headings
           that match what the blocks actually hold (WI-402). Calling a
           recruiting trial's status "what they found" would read as a result. *@
        <p><strong>@Model.StudiedHeading</strong> @Model.Block(Model.Item.PlainWhatStudied)</p>
        <p><strong>@Model.FoundHeading</strong> @Model.Block(Model.Item.PlainWhatFound)</p>

        <div class="means-block">
            <div class="means-block__head">
                <span class="means-block__icon" aria-hidden="true">i</span>
                <h2>What this means, and what it doesn't</h2>
            </div>
            <p><strong>What it could mean:</strong> @Model.Block(Model.Item.PlainMeans)</p>
            <p><strong>What it doesn't mean:</strong> @Model.Block(Model.Item.PlainDoesntMean)</p>
        </div>
    }
    else if (Model.Item.PlainSummary is not null)
    {
        @* Hook only (older/partial item) — show it honestly, no invented blocks. *@
        <p class="hook">@Model.Block(Model.Item.PlainSummary)</p>
    }
    else
    {
        <p>
            We have not written a plain-language summary of this one yet. The
            title above is the researchers' own wording.
        </p>
    }

    @* The readiness callout ("How close is this to helping patients?", a 1-to-10
       bar) and the repeated "How early is this?" badge both used to sit here.
       The journey handoff folded both into the single "How far along is this
       research?" section above: two indicators measuring different things, in
       different units, in different places on one page is a puzzle to solve
       rather than an answer to read. *@

    <div class="provenance">
        <p>
            Source: @Model.SourceLabel@(Model.Item.PublishedAt is { } date
                ? $", {date.ToString("MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)}"
                : "") ·
            <a href="@Model.Item.Url" rel="noopener">Read the original</a>
        </p>

        @if (Model.CorrectionNote is not null)
        {
            <p><strong>Correction:</strong> @Model.CorrectionNote</p>
        }

        <p class="ai-note">
            This plain-language summary was written by AI and published
            automatically after passing our automatic safety checks.
            <a href="/how-we-write">How we write.</a>
        </p>

        <details class="report-problem">
            <summary>Report a problem with this summary</summary>
            <form method="post" asp-page-handler="Report">
                <input type="hidden" name="slug" value="@Model.Item.Slug" />
                <label for="report-reason">
                    What looks wrong? (optional, this flags the summary for another look)
                </label>
                <textarea id="report-reason" name="reason" rows="3"></textarea>
                <p><button type="submit">Send report</button></p>
            </form>
        </details>
    </div>
</div>
