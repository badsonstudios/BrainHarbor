@using BrainHarbor.Web.Middleware
@{
    var isLargeText = TextSize.IsLarge(Context);
    // Plain-link toggle (no-JS fallback): middleware turns the querystring
    // into the cookie and redirects back to the clean URL.
    var toggleHref = TextSize.ToggleHref(Context);
}
<!DOCTYPE html>
<html lang="en" class="@(isLargeText ? "text-large" : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BrainHarbor</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" media="print" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
        <div class="container">
            <a class="site-name" asp-page="/Index">BrainHarbor</a>
            @* v1 nav per docs/sitemap.md. Targets land in WI-103 (/get-help-now),
               M2 (/research), and M4 (/trials, /digest) — dead links until then. *@
            <nav class="site-nav" aria-label="Main">
                <ul>
                    <li><a href="/research">Research</a></li>
                    <li><a href="/trials">Trials</a></li>
                    <li><a href="/digest">Digest</a></li>
                    <li><a class="nav-cta" href="/get-help-now">Get Help Now</a></li>
                </ul>
            </nav>
            <a class="text-toggle" href="@toggleHref">
                <span aria-hidden="true">Aa</span>
                @(isLargeText ? "Standard text" : "Larger text")
            </a>
        </div>
    </header>
    <main id="main-content" class="container">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container">
            @* Footer links per the handoff; /about, /how-we-write, /glossary,
               /terms are dead until WI-104/105/107, same policy as the nav. *@
            <ul>
                <li><a href="/about">About</a></li>
                <li><a href="/how-we-write">How we write</a></li>
                <li><a href="/glossary">Glossary</a></li>
                <li><a href="/get-help-now">Get Help Now</a></li>
                <li><a asp-page="/Privacy">Privacy</a></li>
                <li><a href="/terms">Terms</a></li>
            </ul>
            <p>
                BrainHarbor shares research news in plain language. It is not
                medical advice. Talk with your care team before making decisions
                about your health.
            </p>
            <p class="ai-note">
                Summaries are drafted with AI assistance and reviewed by a
                person before publishing.
                <a href="/how-we-write">Read how we write.</a>
            </p>
        </div>
    </footer>

    <script src="~/js/htmx.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
