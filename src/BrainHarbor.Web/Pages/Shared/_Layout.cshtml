@using BrainHarbor.Web.Middleware
@{
    var isLargeText = TextSize.IsLarge(Context);
    // Plain-link toggle (no-JS fallback): middleware turns the querystring
    // into the cookie and redirects back to the clean URL.
    var toggleHref = TextSize.ToggleHref(Context);
}
<!DOCTYPE html>
<html lang="en" class="@(isLargeText ? "text-large" : null)">
@{
    var pageTitle = ViewData["Title"] is { } t ? $"{t} - BrainHarbor" : "BrainHarbor";
    var metaDescription = ViewData["Description"] as string
        ?? "Brain tumor research and news in plain language, for patients and caregivers.";
    var request = Context.Request;
    var canonical = $"{request.Scheme}://{request.Host}{request.Path}";
    var ogType = ViewData["OgType"] as string ?? "website";
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@metaDescription" />
    <link rel="canonical" href="@canonical" />

    @* Open Graph + Twitter, so a shared item link unfurls with its plain-language
       title and summary rather than a bare URL (WI-308). *@
    <meta property="og:site_name" content="BrainHarbor" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:url" content="@canonical" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    @* A shared link with no image unfurls as a grey box. The lockup PNG, not
       the SVG: the renderer belongs to the social network, not to us. Absolute
       URL is required — og:image does not accept a relative path. *@
    <meta property="og:image" content="@($"{request.Scheme}://{request.Host}/img/brand/lockup-1600.png")" />
    <meta property="og:image:alt" content="Brain Harbor" />
    <meta name="twitter:image" content="@($"{request.Scheme}://{request.Host}/img/brand/lockup-1600.png")" />

    @* Brand icons (docs/design/entry-hub-handoff/brand/README.md). The SVG is
       served first for browsers that take it, the 32px PNG covers the rest, and
       favicon.ico stays for the ones that only ever ask for /favicon.ico. The
       apple-touch icon is deliberately opaque and square — iOS paints alpha
       BLACK, so a rounded transparent icon shows black corners. *@
    <link rel="icon" href="/img/brand/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/img/brand/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/img/brand/apple-touch-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0d3b4a" />

    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="BrainHarbor research" href="/feed.xml" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" media="print" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    @* Persistent helpline band (WI-103): on every page, findable in one
       second by a panicking person. PLAN.md §3 — always one tap to a human. *@
    <aside class="helpline-band" aria-label="Helpline">
        <div class="container">
            <span>Need to talk to someone?</span>
            <a class="tel" href="tel:8008862282">ABTA CareLine: 800-886-2282</a>
            <a href="/get-help-now">More help options</a>
        </div>
    </aside>
    <header class="site-header">
        <div class="container">
            @* alt is the NAME, never "logo" (brand README): a screen reader
               should hear what a sighted reader sees. width/height are the
               artwork's own ratio so the header cannot reflow while the SVG
               loads; CSS sizes it in rem so it grows with large-text mode. *@
            <a class="site-name" asp-page="/Index">
                <img src="~/img/brand/lockup-no-tagline.svg" alt="Brain Harbor"
                     width="920" height="210" />
            </a>
            @* v1 nav per docs/sitemap.md. Targets land in WI-103 (/get-help-now),
               M2 (/research) and M4 (/trials). /digest is the last dead link. *@
            <nav class="site-nav" aria-label="Main">
                <ul>
                    <li><a href="/research">Research</a></li>
                    @* "What is this thing I have" is the first question a newly
                       diagnosed person asks, so it earns a place in the nav
                       rather than only a footer link. *@
                    <li><a href="/tumors">Tumor types</a></li>
                    <li><a href="/trials">Trials</a></li>
                    <li><a href="/digest">Digest</a></li>
                    <li><a href="/search">Search</a></li>
                    <li><a class="nav-cta" href="/get-help-now">Get Help Now</a></li>
                </ul>
            </nav>
            <a class="text-toggle" href="@toggleHref">
                <span aria-hidden="true">Aa</span>
                @(isLargeText ? "Standard text" : "Larger text")
            </a>
        </div>
    </header>
    @* Full-bleed content between the header and main — the homepage's hero
       band is edge-to-edge navy, so it cannot live inside main's container.
       Optional: every other page renders nothing here. *@
    @await RenderSectionAsync("Banner", required: false)
    <main id="main-content" class="container">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container">
            @* Footer links per the handoff. All live as of WI-107; /about,
               /how-we-write, /privacy, /terms are curated Markdown pages
               served by the ContentPage catch-all. *@
            <ul>
                <li><a href="/about">About</a></li>
                <li><a href="/how-we-write">How we write</a></li>
                <li><a href="/tumors">Tumor types</a></li>
                <li><a href="/glossary">Glossary</a></li>
                <li><a href="/get-help-now">Get Help Now</a></li>
                <li><a href="/privacy">Privacy</a></li>
                <li><a href="/terms">Terms</a></li>
            </ul>
            <p>
                BrainHarbor shares research news in plain words. It is not
                medical advice. Talk with your care team before you make
                choices about your health.
            </p>
            <p class="ai-note">
                AI writes our summaries. Each one must pass our safety
                checks, then it goes up on its own.
                <a href="/how-we-write">Read how we write.</a>
            </p>
            @* On every page, because a good idea occurs to someone wherever
               they happen to be. Labelled by purpose, not by the mailbox name:
               "support" would read as "help me" to someone who needs the
               CareLine, which sits at the top of this same page. *@
            <p class="footer-suggest">
                Ideas to make this site better?
                <a href="mailto:support@brainharbor.org">support@brainharbor.org</a>
            </p>
        </div>
    </footer>

    <script src="~/js/htmx.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
