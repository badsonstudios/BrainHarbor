@page
@model IndexModel
@{
    ViewData["Title"] = "Real brain tumor research in plain language";
    ViewData["Description"] =
        "Real brain tumor research and news, put into plain words by AI and checked " +
        "automatically before it publishes. For patients and caregivers.";
}

@* Homepage per docs/design/homepage-handoff ("Harbor Banner"). The shape is the
   point: one hero band, two doors, then updates. The previous layout stacked a
   hero paragraph, three doors and a full-width AI panel, which pushed the first
   real update about a screen and a half down the page. *@

@section Banner {
<section class="hero-band">
    <img class="hero-band__watermark" src="~/img/brand/mark-mono-white.svg" alt="" aria-hidden="true" />
    <div class="container hero-band__inner">
        @* The lockup IS the h1. The visually-hidden text carries the heading —
           alt text never appears in a screen reader's heading list, and heading
           navigation is a primary way this audience moves around a page. The
           image is decorative because the header logo already announces the
           name; without that you get "Brain Harbor" twice in a row. *@
        <h1>
            <span class="visually-hidden">Real brain tumor research, in plain language.</span>
            <img src="~/img/brand/lockup-horizontal-dark-bg.svg" alt="" aria-hidden="true"
                 width="920" height="210" />
        </h1>

        <div class="doors">
            <a class="door door--primary" href="/start">
                <span class="door__icon" aria-hidden="true">1</span>
                <span>
                    <strong class="door__title">Just diagnosed?</strong>
                    <span>Start here. Your words explained.</span>
                </span>
            </a>
            <a class="door door--secondary" href="/get-help-now">
                <span class="door__icon" aria-hidden="true">&#9990;</span>
                <span>
                    <strong class="door__title">Talk to someone</strong>
                    <span>Free ABTA CareLine: 800-886-2282</span>
                </span>
            </a>
        </div>

        @* The AI notice proper sits at the foot of the page, so it stops
           standing between the reader and the content. But nobody should get
           through eight summaries before learning who wrote them, so the
           admission leads here in one sentence. "Scientists do the research"
           comes first on purpose: naming AI without it invites the worse
           misreading, that AI did the science. *@
        <p class="hero-band__disclosure">
            Scientists do the research. AI puts what they found into plain words.
            AI can make mistakes, so we always link to the study itself.
            <a href="/how-we-write">See how we write.</a>
        </p>
    </div>

    <svg class="wave-edge" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M0 40 C160 8 300 66 460 44 C620 22 760 62 920 44 C1080 26 1240 8 1440 34 L1440 70 L0 70 Z" fill="#ffffff" />
        <path d="M0 52 C160 26 300 74 460 54 C620 34 760 70 920 54 C1080 38 1240 22 1440 46 L1440 70 L0 70 Z" fill="#ffffff" opacity=".5" />
    </svg>
</section>
}

@if (Model.Latest.Count > 0)
{
    <section aria-labelledby="latest-title">
        <div class="section-head">
            <div class="section-head__title">
                <img src="~/img/brand/mark-color.svg" alt="" aria-hidden="true" width="46" height="46" />
                <h2 id="latest-title">Latest updates</h2>
            </div>
            <a class="button" href="/research">See all updates →</a>
        </div>

        <svg class="wave-rule" viewBox="0 0 600 14" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M0 8 C70 2 120 13 190 8 C260 3 310 12 380 8 C450 4 520 11 600 6"
                  fill="none" stroke="#0d6a86" stroke-width="3" stroke-linecap="round" opacity=".55" />
        </svg>

        <p class="text-muted">More marks mean the finding has been tested more.</p>

        <ul class="feed-grid">
            @foreach (var row in Model.Latest)
            {
                <partial name="_FeedCard" model="Model.ToCard(row)" />
            }
        </ul>

        @* A div, not a p: the global `p` rule caps at --measure (65ch), which
           would centre this inside a ~630px box rather than the content width
           and read as accidentally left-shifted. *@
        <div class="see-all-row">
            <a class="button button--outline button--lg" href="/research">See all research updates →</a>
        </div>
    </section>
}

@* Suggestions box (Dan's ask, 2026-08-15). The address is support@, but the
   inbox is for ideas about the site, not for help — and a frightened reader can
   easily read "support" as "help me" and then wait days for an answer. So the
   copy says what it is for, and what to do instead if the need is urgent, with
   the CareLine right there rather than a link away. *@
<section class="suggest" aria-labelledby="suggest-title">
    <h2 id="suggest-title">Tell us how to make this better</h2>
    <p>
        This site is new. If something here is confusing, or you know what would
        help, we want to hear it.
        <a href="mailto:support@brainharbor.org">support@brainharbor.org</a>
    </p>
    <p class="suggest__not">
        That inbox is for ideas about this website. It is not a way to get
        medical help or urgent help. To talk with someone now, call the free
        ABTA CareLine: <a class="tel" href="tel:8008862282">800-886-2282</a>.
    </p>
</section>

<section class="ai-notice" aria-labelledby="ai-notice-title">
    <h2 id="ai-notice-title">AI writes these summaries</h2>
    <p>
        Scientists do the research. AI puts it into plain words, and safety
        checks run before it publishes. A person does not check every one.
        Those checks miss some mistakes, so always read the study we link to
        and talk with your care team.
        <a href="/how-we-write">See how we write →</a>
    </p>
</section>
