@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

@* Calm, plain-language error page (WI-103) — reached via UseExceptionHandler
   in production. The helpline band renders from the layout as everywhere. *@

<h1>Something went wrong</h1>
<p>
    The problem is on our side, not yours. Please try again in a few minutes.
</p>

<p>Here is where you can go instead:</p>
<ul>
    <li><a href="/">Go to the home page</a></li>
    <li><a href="/get-help-now">Talk to someone now</a></li>
</ul>

@if (Model.ShowRequestId)
{
    <p><small>Error code you can mention if you contact us: <code>@Model.RequestId</code></small></p>
}
