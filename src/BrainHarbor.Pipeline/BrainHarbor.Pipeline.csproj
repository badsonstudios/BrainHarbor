<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>8b4c21c8-bbe8-448b-92b0-8e0bbe3d3e37</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Parsing and windowing helpers are internal but must be unit-testable
         without going through the network. -->
    <InternalsVisibleTo Include="BrainHarbor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versioned prompt templates ship beside the app (WI-302/303). -->
    <Content Include="Prompts\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The safety checks are shared with the Web app, which re-runs them over
         a stored summary to explain a flag to the reviewer (WI-418). -->
    <ProjectReference Include="..\BrainHarbor.Safety\BrainHarbor.Safety.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
  </ItemGroup>

</Project>
