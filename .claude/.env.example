# ─────────────────────────────────────────────────────────────────────────────
# .env.example — committed template. Copy to `.claude/.env` and fill in values:
#
#   Copy-Item .claude/.env.example .claude/.env      (PowerShell)
#   cp .claude/.env.example .claude/.env             (bash)
#
# The real `.claude/.env` is git-ignored and must NEVER be committed.
# App-runtime secrets ALSO go into `dotnet user-secrets` — see
# .claude/skills/startup/references/api-keys-config.md for the full map.
# ─────────────────────────────────────────────────────────────────────────────

# GitHub personal access token (usually unneeded — gh CLI is keyring-authed)
GITHUB_TOKEN=

# GitHub repository URL (not secret; convenience reference for tooling/scripts)
GITHUB_PROJECT=https://github.com/badsonstudios/BrainHarbor

# PubMed / NCBI E-utilities API key (free: https://account.ncbi.nlm.nih.gov/settings/)
NCBI_API_KEY=

# Shared secret for the site's /api/sync/* endpoints (generate: openssl rand -hex 32)
SYNC_API_KEY=

# Local dev Postgres (docker compose, port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=brainharbor
DB_USER=brainharbor
DB_PASSWORD=

# Email service provider API key for the weekly digest (Buttondown/Kit — from M4)
# ESP_API_KEY=

# NOTE: There is intentionally NO ANTHROPIC_API_KEY. Summarization runs through
# the locally-installed Claude Code CLI under the existing subscription.

# Optional overrides for the opt-in build-test-gate Stop hook
# BUILD_CMD=dotnet build --nologo -v quiet
# TEST_CMD=dotnet test --nologo -v quiet
