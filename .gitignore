# Secrets — never commit (a PreToolUse hook also blocks staging these)
.claude/.env
.claude/.env.local
.claude/settings.local.json

# Claude working files
.claude/work_files/*
!.claude/work_files/.gitkeep

# .NET
bin/
obj/
*.user
.vs/
artifacts/

# Node (if ever needed)
node_modules/

# OS
Thumbs.db
.DS_Store

# The break-test harness's interrupted-run marker (.claude/work_files/*/break-tests.py).
# It is written at the repo root before the first mutation and removed once the
# originals are restored, so it only exists while a run is in flight or after one
# was killed. Ignored so a killed run cannot end up staged (WI-519).
.break-tests-running

# Raw Unsplash originals (heavy) — optimized versions live in wwwroot/img/cards
/images/*.jpg
/images/*.jpeg
/images/*.png
